# Local .terraform directories
**/.terraform/*

# modules/ isn't an independently-initialized root config — any lock file
# that shows up there is just a side effect of a linter/validator running
# `terraform init` scoped to that directory, not a real dependency lock.
# The real one lives at the repo root (and in bootstrap/*, which are their
# own root configs) and IS committed.
modules/*/.terraform.lock.hcl

# Terraform state — remote S3 backend only, never local/committed
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json
!example.tfvars

# Local-only overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

.DS_Store
